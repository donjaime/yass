#!/bin/sh
# YASS prepare-commit-msg hook: with plans kept apart from the code, adds a `yass:` trailer naming
# the commit's change (from `yass use`, else the branch name, else earlier commits on the branch).
# It never overwrites a trailer you wrote, skips merges, and does nothing when plans are in the repo.
if ! command -v yass >/dev/null 2>&1; then
  exit 0
fi
exec yass hook --prepare-msg "$@"
